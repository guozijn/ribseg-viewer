# Required: path to the trained RibCXR checkpoint.
RIBCXR_CHECKPOINT=../model/multi_unetpp_b0_dice.pth

# Optional: default supported inference config.
RIBCXR_CONFIG=../model/configs/multi_unetpp_b0_dice.yaml

# Optional runtime settings.
RIBCXR_DEVICE=cuda
RIBCXR_THRESHOLD=0.5
RIBCXR_MAX_UPLOAD_MB=32
RIBCXR_RESULTS_DIR=/tmp/ribseg_results
